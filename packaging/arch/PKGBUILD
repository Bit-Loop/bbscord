# Maintainer: Bit-Loop <https://github.com/Bit-Loop/bbscord>
pkgname=bbscord
pkgver=0.1.0
pkgrel=1
pkgdesc="Retro BBS-styled Rust Discord TUI client with DAVE E2EE voice, Group DMs, WebRTC screensharing, animated GIFs, btop themes, and 16x2 LCD to 4K layouts"
arch=('x86_64' 'aarch64')
url="https://github.com/Bit-Loop/bbscord"
license=('MIT' 'Apache-2.0')
depends=(
  'alsa-lib'
  'dbus'
  'gcc-libs'
  'glibc'
  'gst-plugins-bad'
  'gst-plugins-base'
  'gst-plugins-good'
  'gstreamer'
  'opus'
)
makedepends=(
  'cargo'
  'clang'
  'cmake'
  'git'
  'pkgconf'
  'rust'
)
optdepends=(
  'btop: system btop .theme palettes auto-discovered in /usr/share/btop/themes'
  'gst-libav: software H.264/VP8/VP9 fallback decoding for Go Live screenshares'
  'gst-plugins-ugly: x264enc software H.264 broadcasting fallback'
  'mpv: low-latency borderless pop-out window sink for Go Live screenshares'
  'pipewire: Wayland screen capture and low-latency audio routing'
  'wl-clipboard: Wayland clipboard integration (wl-copy)'
  'xclip: X11 clipboard integration'
  'xdg-desktop-portal: Wayland/X11 portal monitor and window picker for Go Live'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p bbscord
}

check() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
  ./target/release/bbscord --headless-smoke
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 "target/release/bbscord" "${pkgdir}/usr/bin/bbscord"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
